{
  "type": "minecraft:disk",
  "state_provider": {
    "type": "minecraft:rule_based",
    "fallback": {
      "id": "minecraft:dirt"
    },
    "rules": [
      {
        "if_true": {
          "type": "minecraft:matching_block_tag",
          "offset": [
            0,
            0,
            0
          ],
          "tag": "minecraft:base_stone_overworld"
        },
        "then": {
          "id": "minecraft:stone"
        }
      },
      {
        "if_true": {
          "type": "minecraft:all_of",
          "predicates": [
            {
              "type": "minecraft:matching_blocks",
              "offset": [
                0,
                0,
                0
              ],
              "blocks": "minecraft:dirt"
            },
            {
              "type": "minecraft:matching_blocks",
              "offset": [
                0,
                1,
                0
              ],
              "blocks": [
                "minecraft:snow_block",
                "minecraft:powder_snow"
              ]
            }
          ]
        },
        "then": {
          "type": "minecraft:simple",
          "state": {
            "id": "minecraft:podzol",
            "properties": {
              "snowy": "true"
            }
          }
        }
      }
    ]
  },
  "target": {
    "type": "minecraft:matching_blocks",
    "blocks": [
      "minecraft:dirt"
    ]
  },
  "radius": {
    "type": "minecraft:uniform",
    "min_inclusive": 3,
    "max_inclusive": 5
  },
  "half_height": 3
}
