{
  "type": "minecraft:disk",
  "state_provider": {
    "type": "minecraft:rule_based",
    "fallback": {
      "id": "minecraft:tuff"
    },
    "rules": [
      {
        "if_true": {
          "type": "minecraft:all_of",
          "predicates": [
            {
              "type": "minecraft:matching_blocks",
              "blocks": "minecraft:snow"
