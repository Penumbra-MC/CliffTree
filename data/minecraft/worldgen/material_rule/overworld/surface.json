      "then_run": {
        "type": "minecraft:sequence",
        "sequence": [
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:biome",
              "biome_is": [
                "minecraft:wooded_badlands",
                "clifftree:coniferous_badlands"
              ]
            },
            "then_run": "clifftree:overworld/grassy_badlands"
          },
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:biome",
